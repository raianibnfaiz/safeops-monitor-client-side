# SafeOps Monitor - Environment Variables
# Copy this file to .env and set your backend URLs.
# Do not commit real production secrets.

# Backend API base URL (include /api)
# Local:  http://localhost:5000/api
# Remote: https://your-backend-host/api
VITE_API_BASE_URL=

# Socket.IO server origin (no /api suffix)
# Local:  http://localhost:5000
# Remote: https://your-backend-host
VITE_SOCKET_URL=

# App environment
VITE_APP_ENV=development

# Optional: token storage key (default: safeops_token)
VITE_TOKEN_KEY=safeops_token

# Mock auth (true = bypass backend for UI testing, false = use real backend)
VITE_MOCK_AUTH=false
